{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/style_confirmation",
  "title": "Production style comparison and confirmation",
  "type": "object",
  "required": ["version", "project_id", "mode", "content_basis", "catalog_review", "candidates", "recommendation", "format", "approval"],
  "properties": {
    "version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["comparison", "explicit_choice", "preserve_source"]},
    "content_basis": {"type": "string", "minLength": 1},
    "catalog_review": {
      "type": "object", "required": ["sources", "reviewed_count"],
      "properties": {
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "reviewed_count": {"type": "integer", "minimum": 0}
      }, "additionalProperties": false
    },
    "candidates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "reference", "fit", "tradeoff", "visual_grammar", "beat_examples", "runtime_requirements"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["style_pack", "series_style", "custom", "preserve_source"]},
          "reference": {"type": "string", "minLength": 1},
          "fit": {"type": "string", "minLength": 1},
          "tradeoff": {"type": "string", "minLength": 1},
          "visual_grammar": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "beat_examples": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "runtime_requirements": {"type": "array", "items": {"type": "string"}},
          "selection": {"type": "object"},
          "preview_paths": {"type": "array", "items": {"type": "string"}}
        }, "additionalProperties": false
      }
    },
    "recommendation": {
      "type": "object", "required": ["candidate_id", "reason"],
      "properties": {
        "candidate_id": {"type": "string"},
        "reason": {"type": "string", "minLength": 1}
      }, "additionalProperties": false
    },
    "format": {
      "type": "object", "required": ["aspect_ratio", "width", "height", "fps", "container", "basis", "status"],
      "properties": {
        "aspect_ratio": {"type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "container": {"type": "string", "minLength": 1},
        "basis": {"type": "string", "minLength": 1},
        "status": {"enum": ["proposed", "approved"]},
        "approval_evidence": {"type": "string", "minLength": 1}
      }, "additionalProperties": false,
      "allOf": [{"if": {"properties": {"status": {"const": "approved"}}}, "then": {"required": ["approval_evidence"]}}]
    },
    "approval": {
      "type": "object", "required": ["status"],
      "properties": {
        "status": {"enum": ["pending", "approved", "rejected"]},
        "candidate_id": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }, "additionalProperties": false,
      "allOf": [{"if": {"properties": {"status": {"const": "approved"}}}, "then": {"required": ["candidate_id", "evidence"]}}]
    },
    "metadata": {"type": "object"}
  },
  "allOf": [{"if": {"properties": {"mode": {"const": "comparison"}}}, "then": {"properties": {"candidates": {"minItems": 3}}}}],
  "additionalProperties": false
}
