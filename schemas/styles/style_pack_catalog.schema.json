{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","required":["version","packs"],"additionalProperties":false,
  "properties":{
    "version":{"const":"1.0"},
    "packs":{"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","slug","name","group","finance_use","visual_contract","techniques","native_entry","specimen","requires","evidence","avoid"],
      "properties":{
        "id":{"type":"string","pattern":"^lemo-[a-z0-9-]+$"},
        "slug":{"type":"string","pattern":"^[a-z0-9-]+$"},
        "name":{"type":"string","minLength":1},"group":{"type":"integer","minimum":1},
        "category":{"type":"string"},"finance_fit":{"enum":["supporting","specialist"]},
        "implementation":{"enum":["native-techniques","adapted-techniques"]},
        "support_files":{"type":"array","items":{"type":"string","enum":["vendor"]}},
        "finance_use":{"type":"array","minItems":1,"items":{"type":"string"}},
        "visual_contract":{"type":"string","minLength":1},
        "techniques":{"type":"array","minItems":1,"items":{"type":"string"}},
        "native_entry":{"type":"string","pattern":"^engine/[a-zA-Z0-9_/-]+\\.js$"},
        "specimen":{"type":"string"},
        "requires":{"type":"array","items":{"type":"string"}},
        "evidence":{"type":"string"},"avoid":{"type":"string"}
      }
    }}
  }
}
